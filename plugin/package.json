{
  "name": "dsh-paperflight",
  "version": "0.1.0-preview.60",
  "description": "纸航 Paperflight for DSH — future-retro DSH workbench with preset-scoped optional browser and terminal tools",
  "type": "module",
  "main": "index.mjs",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./tool-cmd": "./tool-cmd.mjs",
    "./tool-browser": "./tool-browser.mjs",
    "./preset-guide": "./preset-guide.mjs"
  },
  "files": [
    "index.mjs",
    "projection.mjs",
    "child-service.mjs",
    "client.js",
    "cordis.patch.yml",
    "payload",
    "source",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "MANIFEST.sha256.json",
    "agent-tools.mjs",
    "agent-browser.mjs",
    "browser-mcp.mjs",
    "browser-reading.mjs",
    "browser-files.mjs",
    "browser-image.mjs",
    "session-deletion.mjs",
    "tool-cmd.mjs",
    "tool-browser.mjs",
    "preset-guide.mjs",
    "preset-guide.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bagpipe1289/dsh-paperflight.git"
  },
  "dependencies": {
    "playwright-core": "1.64.0-alpha-1790635538000",
    "@playwright/mcp": "0.0.83"
  },
  "keywords": [
    "deepseek-harness",
    "paperflight",
    "future-retro",
    "web-interface"
  ]
}
