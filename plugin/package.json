{
  "name": "dsh-mai-shell",
  "version": "0.1.0-preview.47",
  "description": "纸航 Paperflight for DSH — paper-textured future-retro web interface with optional shared browser and terminal tools",
  "type": "module",
  "main": "index.mjs",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "projection.mjs",
    "child-service.mjs",
    "client.js",
    "cordis.patch.yml",
    "payload",
    "source",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "MANIFEST.sha256.json",
    "agent-tools.mjs",
    "agent-browser.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bagpipe1289/dsh-paperflight.git"
  },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "keywords": [
    "deepseek-harness",
    "paperflight",
    "future-retro",
    "web-interface"
  ]
}
